{
  "name": "dsh-plugin-store",
  "version": "0.2.0",
  "description": "App-store style directory of DeepSeek Harness plugins on npm, refreshed daily",
  "icon": "./icon.png",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yang051211/dsh-plugin-store.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "directory:discover": "node tools/directory/cli.mjs discover",
    "directory:refresh": "node tools/directory/cli.mjs refresh",
    "directory:stats": "node tools/directory/cli.mjs stats",
    "directory:scan": "node tools/directory/cli.mjs scan",
    "directory:build": "node tools/directory/cli.mjs build",
    "directory:check": "node tools/directory/cli.mjs check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/semver": "7.8.0",
    "esbuild": "^0.28.2",
    "marked": "18.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  }
}
